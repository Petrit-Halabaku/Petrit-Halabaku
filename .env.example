# Copy to `.env` and fill in your values. Never commit `.env`.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Your Name"
NEXT_PUBLIC_NICKNAME="YN"
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# EmailJS (https://www.emailjs.com/) — use your dashboard IDs
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_USER_ID=your_public_key

# Google Analytics (optional)
NEXT_PUBLIC_GTAG=G-XXXXXXXXXX

# Mapbox public token (https://account.mapbox.com/) — must start with pk.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token

# Set to "true" to show maintenance mode in the client
NEXT_PUBLIC_MAINTENANCE_MODE=false
